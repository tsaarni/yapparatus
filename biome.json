{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "style": { "noNonNullAssertion": "error", "useImportType": "error" }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/*.md",
      "!**/dist",
      "!lib",
      "!**/dist-single",
      "!**/node_modules",
      "!**/.yapparatus",
      "!**/test-results",
      "!**/playwright-report"
    ]
  }
}
