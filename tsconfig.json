  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "outDir": ".cache/tsc/root",
    "tsBuildInfoFile": ".cache/tsc/root.tsbuildinfo"
  },
  "include": ["tests", "scripts", "*.ts"],
  "references": [
    { "path": "src/document" },
    { "path": "src/protocol" },
    { "path": "src/diagram" },
    { "path": "src/chart" },
    { "path": "src/compiler" },
    { "path": "src/server" },
    { "path": "src/agent" },
    { "path": "src/vite" },
    { "path": "src/web" }
  ]
}
