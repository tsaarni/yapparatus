{
  "name": "yapparatus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "yap": "./lib/vite/yap.js"
  },
  "exports": {
    ".": "./src/web/index.ts",
    "./agent": {
      "types": "./lib/agent/index.d.ts",
      "default": "./lib/agent/index.js"
    },
    "./vite": {
      "types": "./lib/vite/plugin.d.ts",
      "default": "./lib/vite/plugin.js"
    },
    "./styles.css": "./src/web/style/styles.css",
    "./theme.stylex": "./src/web/style/theme.stylex.ts"
  },
  "scripts": {
    "dev": "pnpm build:lib && node lib/vite/yap.js dev",
    "build": "pnpm build:lib && node lib/vite/yap.js build",
    "build:single": "pnpm build:lib && node lib/vite/yap.js build --single",
    "preview": "pnpm build:lib && node lib/vite/yap.js preview",
    "verify": "biome check . && tsc -b && node scripts/check-styles.ts && node scripts/check-comments.ts",
    "format": "biome check --write .",
    "test": "pnpm build:lib && playwright test",
    "test:unit": "node --experimental-strip-types --test \"tests/unit/**/*.test.ts\"",
    "api:report": "node scripts/api-report.ts",
    "screenshots": "pnpm build:lib && node scripts/screenshots.ts",
    "build:lib": "node -e \"fs.rmSync('lib', { recursive: true, force: true })\" && tsc -p tsconfig.lib.json",
    "prepare": "tsc -p tsconfig.lib.json"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/energy-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.151",
    "@iconify-json/selfhst": "^1.2.27",
    "@mdx-js/rollup": "^3.1.1",
    "@observablehq/plot": "0.6.19",
    "@resvg/resvg-js": "^2.6.2",
    "@stylexjs/stylex": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@vitejs/plugin-react": "^6.2.1",
    "estree-util-value-to-estree": "^3.5.0",
    "fontkit": "^3.0.0",
    "hast-util-from-html": "^2.1.0",
    "hast-util-to-string": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.6.0",
    "temml": "^0.14.0",
    "unist-util-remove-position": "^5.0.0",
    "unist-util-visit": "^5.2.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.13",
    "@biomejs/biome": "^2.6.5",
    "@mdx-js/mdx": "3.1.1",
    "@playwright/test": "^1.65.0",
    "@types/fontkit": "^2.0.9",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mdast-util-mdx-jsx": "^3.2.1",
    "typescript": "^7.0.2"
  },
  "files": [
    "src",
    "lib",
    "docs/design",
    "tsconfig.json",
    "tsconfig.base.json"
  ]
}
