{
  "name": "yapparatus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "yap": "./lib/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./agent": {
      "types": "./lib/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./vite": {
      "types": "./lib/vite.d.ts",
      "default": "./lib/vite.js"
    },
    "./styles.css": "./src/reader/styles.css",
    "./theme.stylex": "./src/reader/theme.stylex.ts"
  },
  "scripts": {
    "dev": "pnpm build:lib && node lib/cli.js dev",
    "build": "pnpm build:lib && node lib/cli.js build",
    "build:single": "pnpm build:lib && node lib/cli.js build --single",
    "preview": "pnpm build:lib && node lib/cli.js preview",
    "verify": "biome check . && tsc --noEmit && node scripts/check-styles.ts",
    "format": "biome check --write .",
    "test": "pnpm build:lib && playwright test",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "api:report": "node scripts/api-report.ts",
    "build:lib": "tsc -p tsconfig.lib.json",
    "prepare": "tsc -p tsconfig.lib.json"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/energy-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.151",
    "@iconify-json/selfhst": "^1.2.27",
    "@mdx-js/rollup": "^3.1.1",
    "@observablehq/plot": "0.6.19",
    "@shikijs/rehype": "^4.6.0",
    "@stylexjs/stylex": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@vitejs/plugin-react": "^6.2.1",
    "estree-util-value-to-estree": "^3.5.0",
    "hast-util-to-string": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "unist-util-visit": "^5.2.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@mdx-js/mdx": "3.1.1",
    "@playwright/test": "^1.65.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mdast-util-mdx-jsx": "^3.2.1",
    "typescript": "^7.0.2"
  },
  "files": [
    "src",
    "lib",
    "docs/design",
    "tsconfig.json"
  ]
}
