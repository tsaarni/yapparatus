{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // The chart code draws into a document, from the browser or from linkedom, so it names DOM
    // types. Each directory's own project still keeps the DOM out of the others.
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "composite": false,
    "emitDeclarationOnly": false,
    "rootDir": "src",
    "outDir": "lib",
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/vite/yap.ts",
    "src/vite/plugin.ts",
    "src/agent/index.ts",
    "src/protocol/runtime.d.ts"
  ]
}
